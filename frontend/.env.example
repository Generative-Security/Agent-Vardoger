# Base URL for the Agent Vardøger control-plane API.
# Defaults to "/api" (proxied to the backend in dev via vite.config.ts).
# Set this when the SPA is served from a different origin than the API — e.g.
# the CloudFormation ControlPlaneFunctionUrl (auth=none) or ControlPlaneApiUrl
# (auth=cognito), each with "/api" appended.
VITE_API_BASE_URL=/api

# Optional Test Console defaults. The Test Console sends prompts through your
# Bedrock AgentCore Gateway. If set, these pre-fill the console fields; the
# operator can still override them in the UI. Leave empty to enter them by hand.
# These are BAKED INTO THE PUBLIC BUNDLE at build time and become publicly
# visible. NEVER put a secret-bearing URL here.
VITE_TEST_CONSOLE_GATEWAY_URL=
VITE_TEST_CONSOLE_TOOL_NAME=

# Dev-only: backend origin the dev server proxies /api to (defaults to :8000).
VITE_DEV_PROXY=

# Auth mode the SPA should present: none | token | cognito. Must match the
# control plane's VARDOGER_AUTH_MODE. "token" shows an access-token entry
# screen; "cognito" uses the Hosted UI; "none" needs no sign-in.
VITE_AUTH_MODE=none

# --- Cognito Hosted UI sign-in (only for AuthMode=cognito) ---
# Provided by the CloudFormation outputs. When these are set, the SPA runs the
# OAuth PKCE code flow against the Cognito Hosted UI. Leave empty for
# AuthMode=none or token.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
# The redirect URI registered as a Cognito callback URL (the dashboard origin).
VITE_COGNITO_REDIRECT_URI=
